{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoldRush Foundational ABI NFT API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "NFT",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get NFTs For Address",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.covalenthq.com/v1/:chainName/address/:walletAddress/balances_nft/",
            "params": [
              {
                "name": "chainName",
                "value": "",
                "type": "path",
                "description": "Chain slug (e.g., `eth-mainnet`, `base-mainnet`, `solana-mainnet`, `polygon-mainnet`) or numeric chain ID."
              },
              {
                "name": "walletAddress",
                "value": "",
                "type": "path",
                "description": "Wallet address. EVM 0x-prefixed; ENS / Lens / Unstoppable names also accepted on Base service."
              }
            ]
          },
          "docs": "Get NFTs For Address"
        },
        {
          "info": {
            "name": "Check Ownership In NFT Collection For Specific Token",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.covalenthq.com/v1/:chainName/tokens/:collectionContract/nft_token_ids/:tokenId/check_ownership/:walletAddress/",
            "params": [
              {
                "name": "chainName",
                "value": "",
                "type": "path",
                "description": "Chain slug (e.g., `eth-mainnet`, `base-mainnet`, `solana-mainnet`, `polygon-mainnet`) or numeric chain ID."
              },
              {
                "name": "collectionContract",
                "value": "",
                "type": "path"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path"
              },
              {
                "name": "walletAddress",
                "value": "",
                "type": "path",
                "description": "Wallet address. EVM 0x-prefixed; ENS / Lens / Unstoppable names also accepted on Base service."
              }
            ]
          },
          "docs": "Check Ownership In NFT Collection For Specific Token"
        },
        {
          "info": {
            "name": "Check Ownership In NFT Collection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.covalenthq.com/v1/:chainName/tokens/:collectionContract/check_ownership/:walletAddress/",
            "params": [
              {
                "name": "chainName",
                "value": "",
                "type": "path",
                "description": "Chain slug (e.g., `eth-mainnet`, `base-mainnet`, `solana-mainnet`, `polygon-mainnet`) or numeric chain ID."
              },
              {
                "name": "collectionContract",
                "value": "",
                "type": "path"
              },
              {
                "name": "walletAddress",
                "value": "",
                "type": "path",
                "description": "Wallet address. EVM 0x-prefixed; ENS / Lens / Unstoppable names also accepted on Base service."
              }
            ]
          },
          "docs": "Check Ownership In NFT Collection"
        }
      ]
    }
  ],
  "bundled": true
}