{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoldRush Foundational ABI Base API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Base",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get A Block",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.covalenthq.com/v1/:chainName/block_v2/:blockHeight/",
            "params": [
              {
                "name": "chainName",
                "value": "",
                "type": "path",
                "description": "Chain slug (e.g., `eth-mainnet`, `base-mainnet`, `solana-mainnet`, `polygon-mainnet`) or numeric chain ID."
              },
              {
                "name": "blockHeight",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get A Block"
        },
        {
